{
  "name": "gestor-tarefas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gestor de tarefas — cards, projetos, pipelines e priorização por IA. Operável pelo seu agente.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "npm run build && node server/index.js",
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "servidor": "node server/index.js",
    "resumo": "node server/resumo.js",
    "analisar": "node server/analisar.js",
    "tarefas": "node cli/tarefas.js",
    "test": "node --test testes/*.test.js",
    "chave": "node cli/chave.js",
    "demo": "node cli/demo.js",
    "telegram": "node server/escutar.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@scalar/express-api-reference": "^0.10.14",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.0"
  }
}
